# EmailJS (contact form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Writer studio (CMS at /writer/studio). Server-only; leave empty to keep the studio locked.
WRITER_STUDIO_PASSWORD=

# Public URL of the deployed site (used for social previews)
NEXT_PUBLIC_SITE_URL=https://dwdhr.vercel.app

# Supabase (comments in the Blog). Both values are public by design; the security is in the database rules.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
